pipeline {
agent any

tools {
    terraform 'terraform'
}

environment {
    AWS_ACCOUNT_ID = '511197441763'
    AWS_REGION = 'eu-north-1'
    REPO_NAME = 'todo_app'
    IMAGE_NAME = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${REPO_NAME}:latest"
    FIREBASE_KEY_BASE64 = credentials('firebase_key_id')
    EC2_USER = 'ubuntu'
}

options {
    buildDiscarder(logRotator(numToKeepStr: '5'))
    timestamps()
}

stages {

    stage('Clean Workspace') {
        steps { deleteDir() }
    }

    stage('Checkout Code') {
        steps {
            git branch: 'master',
                url: 'https://github.com/Pavithrap7/to_do_app.git'
        }
    }

    stage('Install Python & Dependencies') {
        steps {
            sh '''
                python3 -m venv venv
                . venv/bin/activate
                pip install --upgrade pip
                pip install -r requirements.txt 
		#print()
            '''
        }
    }

    stage('Run Unit Tests') {
        steps {
            sh '''
                . venv/bin/activate
                pytest test/test_main.py -v --maxfail=1 --disable-warnings --junitxml=report.xml
            '''
            junit 'report.xml'
        }
    }

    stage('Terraform Apply - EKS Cluster') {
        steps {
            withCredentials([usernamePassword(credentialsId: 'jenkin_cred', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                sh '''
                    export AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
                    export AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY

		    cd terraform_project/eks
		    rm -rf .terraform
		    terraform init -reconfigure

              
		    if aws eks list-clusters --region ${AWS_REGION} --no-cli-pager | grep -q 'todo-eks'; then
			    terraform import 'module.eks.aws_eks_cluster.this[0]' todo-eks
			    terraform import 'module.eks.aws_cloudwatch_log_group.this[0]' '/aws/eks/todo-eks/cluster'
		    fi
		
		   
		    terraform plan
                    terraform apply -auto-approve

                    aws eks update-kubeconfig --region ${AWS_REGION} --name todo-eks
                '''
            }
        }
    }

    stage('Docker Login & Build') {
        steps {
            withCredentials([usernamePassword(credentialsId: 'aws_cred', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                sh '''
                    aws configure set aws_access_key_id $AWS_ACCESS_KEY_ID
                    aws configure set aws_secret_access_key $AWS_SECRET_ACCESS_KEY
                    aws configure set default.region ${AWS_REGION}

                    aws ecr describe-repositories --repository-names ${REPO_NAME} || aws ecr create-repository --repository-name ${REPO_NAME}

                    aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                    docker build -t ${IMAGE_NAME} .
                    docker push ${IMAGE_NAME}
                '''
            }
        }
    }

    stage('Deploy to EKS') {
        steps {
            sh '''
                kubectl apply -f k8s_deployment.yaml
                kubectl rollout status deployment/todo-app
            '''
        }
    }

    stage('Smoke Tests') {
        steps {
            sh '''
                . venv/bin/activate
                pytest test/test_smoke.py --base-url=http://todo-app.${AWS_REGION}.elb.amazonaws.com:8000 -v --maxfail=1 --disable-warnings --junitxml=smoke_report.xml
            '''
            junit 'smoke_report.xml'
        }
    }
}

post {
    always { echo 'Pipeline finished' }
}


}






